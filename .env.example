# Public URL where this server is reachable (no trailing slash).
APP_ORIGIN=http://localhost:8000

# OIDC issuer. Usually the same as APP_ORIGIN.
ISSUER=http://localhost:8000

# Persistent data directory (SQLite database + RSA signing key).
DATA_DIR=./data

# Set to true when serving over HTTPS. Defaults to true when APP_ORIGIN is https.
SECURE_COOKIES=false

# Trust X-Forwarded-For / X-Forwarded-Proto when behind a reverse proxy.
TRUST_PROXY=false

# Allow new users to create accounts.
ALLOW_REGISTRATION=true

# Token required by the /api/admin/* endpoints and used by the CLI.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-to-a-long-random-value

# Additional browser origins allowed to call the API (comma separated).
ALLOWED_ORIGINS=

# Session/token lifetimes.
SESSION_TTL_DAYS=14
REMEMBER_TTL_DAYS=30
ACCESS_TOKEN_TTL_MINUTES=60
ID_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
AUTH_CODE_TTL_MINUTES=10

# Optional OAuth client seeded on first start.
# Leave DEFAULT_CLIENT_SECRET empty to create a public PKCE client.
DEFAULT_CLIENT_ID=openweb-linux
DEFAULT_CLIENT_NAME=OpenWeb Linux
DEFAULT_CLIENT_SECRET=
# Example: DEFAULT_CLIENT_REDIRECT_URIS=https://openweb.tudominio.com/oauth/callback
DEFAULT_CLIENT_REDIRECT_URIS=
DEFAULT_CLIENT_SCOPES=openid,profile,email,offline_access
